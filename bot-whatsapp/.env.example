# ── Qué proveedor usar ───────────────────────────────────────────────
# web   = tu propio número vía WhatsApp Web (gratis, no oficial, riesgo de baneo)
# cloud = API oficial de Meta (gratis dentro de la ventana de 24 h, número aparte)
PROVEEDOR=web

# ── Solo para PROVEEDOR=cloud ────────────────────────────────────────
# Panel: developers.facebook.com › tu app › WhatsApp › Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Cadena que tú inventas; la escribes igual aquí y en el panel del webhook
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-algo-tuyo
# Revisa cuál es la versión vigente de Graph API en la doc de Meta
GRAPH_VERSION=v23.0
PUERTO=3000

# ── Opcional: habilita el comando /ia ────────────────────────────────
# Sin esta clave el bot funciona igual, solo que /ia responde que está apagado
ANTHROPIC_API_KEY=
