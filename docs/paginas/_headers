/reels/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800

/app.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

/sw.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/.well-known/assetlinks.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/iblo-panel.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="IBLO-Panel.apk"
  Cache-Control: public, max-age=300

# El panel del dueño no va a Google: es una pantalla de inicio de sesión.
/iblo-app
  X-Robots-Tag: noindex, nofollow

# Páginas de otros proyectos que viven en el mismo repo. Si Google las indexa,
# el dominio de IBLO aparece mezclado con cosas que no son de IBLO.
/aquaviva
  X-Robots-Tag: noindex
/cuatro-tiempos
  X-Robots-Tag: noindex
/gabinete
  X-Robots-Tag: noindex
/humo-lento
  X-Robots-Tag: noindex
/kane
  X-Robots-Tag: noindex
/frutiger
  X-Robots-Tag: noindex

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
